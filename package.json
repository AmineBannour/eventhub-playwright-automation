{
  "name": "eventhub-playwright-automation",
  "version": "1.0.0",
  "description": "Team Red - UI & API test automation of the EventHub registration app with Playwright + TypeScript",
  "private": true,
  "scripts": {
    "app": "node app/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:serial": "playwright test --workers=1",
    "test:parallel": "playwright test --workers=4",
    "test:regression": "playwright test --grep @regression",
    "test:data-driven": "playwright test --grep @data-driven",
    "test:failure-demo": "cross-env DEMO_FAILURE=1 playwright test tests/ui/failure-demo.spec.ts --project=ui --workers=4 --repeat-each=2",
    "report": "playwright show-report reports/html",
    "parallel:timeline": "node scripts/parallel-timeline.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3"
  }
}
