# EventHub application under test - LOCAL TEST VALUES ONLY.
# Copy to .env (git-ignored) and change the credentials if you like:
#   cp .env.example .env
APP_PORT=3000
APP_USERNAME=qa_tester
APP_PASSWORD=test@123
# Simulated server processing time in ms (POST/PUT), makes synchronisation matter.
APP_LATENCY_MS=800

# Test framework settings
BASE_URL=http://localhost:3000
# Number of parallel workers (overridden by --workers on the CLI)
WORKERS=4
# Optional: run UI tests on an installed browser (msedge or chrome) instead of Playwright's Chromium
BROWSER_CHANNEL=
